```gitignore
# Dependencies
node_modules/

# External / customized modules
modules/*
!modules/.gitkeep

# Environment variables - never commit
.env

# Database
*.db
*.db-shm
*.db-wal
*.db.backup-*

# Logs
*.log
logs/

# System files
.DS_Store
Thumbs.db

# Build artifacts and test coverage
dist/
.cache/
coverage/

# Local Docker volume
data/

# Local Docker overrides
docker-compose.override.yml

# Local design references
mockups/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local AI development tooling - never publish
.claude/
.codex/
.agents/
.github/skills/
.github/hooks/

# AI development documents
AGENTS.md
CLAUDE.md
PRODUCT.md

# Local development and design context
.superpowers/
.interface-design/
.impeccable/

# Internal documentation and development plans
docs/superpowers/
docs/archive/superpowers/
docs/plans/
docs/integrations/
docs/design/
docs/health-module-plan.md

# Rebranding and internal project documents
REBRANDING.md

# Audit reports - generated locally
docs/audit-report-*.md
docs/claude-md-audit.md
docs/repo-audit-*.md
docs/legal-audit/
docs/ux-audit/
SECURITY_RESEARCH.md

# Installer development and audit documents
docs/installer-audit.md
docs/installer-modernization-plan.md
docs/installer-phase-prompts.md

# Text files that may contain tokens or keys
*.txt
!public/robots.txt

# Screenshot generation scripts
create-screenshots*.js
custom-screenshots.js
seed-demo-simple.js
seed-english-demo*.js

# Temporary Playwright screenshot scripts
.shoot*.mjs
.measure.mjs

# Generated screenshot output
/screenshots/

# Duplicate GitHub Pages staging directory
docs/github-pages/

# macOS duplicate files
* 2.*

# Graphify knowledge graph generated output
graphify-out/
.graphifyignore
scripts/graphify-labels.json
scripts/graphify-labels.mjs

# Git worktrees
.worktrees/
```

.env
node_modules/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backups/
