```env
# Aashiyana - Environment Variables
# Copy this file to .env and adjust the values.

# Server
PORT=3000
NODE_ENV=production
# LOG_LEVEL=info

# Container host port mapping
# The application listens on port 3000 inside the container.
AASHIYANA_HTTP_PORT=8090

# Host bind address
# AASHIYANA_HTTP_BIND=0.0.0.0
# Use 127.0.0.1 when running behind a reverse proxy on the same host.

# Container storage paths
# DATA_DIR=./data
# BACKUP_DIR=./backups
# MODULES_DIR=./modules

# Session
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
# SESSION_SECURE=true

# Database
DB_PATH=/data/aashiyana.db

# Database encryption
DB_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_ENCRYPTION_KEY

# Database schema compatibility
# DB_ALLOW_NEWER_SCHEMA=

# Weather
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=
WEATHER_UNITS=metric

# Legacy OpenWeatherMap integration
# OPENWEATHER_API_KEY=
# OPENWEATHER_CITY=
# OPENWEATHER_UNITS=metric
# OPENWEATHER_LANG=en

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/calendar/google/callback

# Microsoft Outlook Calendar
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://your-domain.com/api/v1/calendar/outlook/callback

# Google Drive Document Storage
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://your-domain.com/api/v1/documents/storage/google-drive/callback

# OpenID Connect / SSO
OIDC_ISSUER=https://auth.example.com/application/o/aashiyana/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-domain.com/api/v1/auth/oidc/callback

# Optional OIDC settings
# OIDC_TRUST_EMAIL_WITHOUT_VERIFIED_CLAIM=true
# OIDC_ALLOW_SIGNUP=false
# AUTH_ALLOW_PASSWORD_LOGIN=false

# Apple Calendar / CalDAV
APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_USERNAME=
APPLE_APP_SPECIFIC_PASSWORD=

# Calendar and contact synchronization
SYNC_INTERVAL_MINUTES=15

# ICS calendar subscriptions
# ICS_SUBSCRIPTION_ALLOW_PRIVATE_NETWORK=false

# Notification channels
# NOTIFICATION_ALLOW_PRIVATE_NETWORK=false

# Budget / Currency Conversion
# FIXER_API_KEY=

# Automatic Backups
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_KEEP=7
# BACKUP_UPLOAD_LIMIT=100mb

# WebDAV Backup
# WEBDAV_BACKUP_ENABLED=true
# WEBDAV_BACKUP_URL=https://cloud.example.com/remote.php/dav/files/username/
# WEBDAV_BACKUP_USERNAME=username
# WEBDAV_BACKUP_PASSWORD=
# WEBDAV_BACKUP_PATH=/aashiyana/backups/
# WEBDAV_BACKUP_KEEP=10

# Upload limit
# MAX_UPLOAD_MB=5

# Local Document Storage
# DOCUMENT_STORAGE_LOCAL_ENABLED=false
# DOCUMENT_STORAGE_LOCAL_PATH=/documents
# DOCUMENT_STORAGE_LOCAL_DIR=./documents

# WebDAV Document Storage
# DOCUMENT_STORAGE_WEBDAV_ENABLED=false
# DOCUMENT_STORAGE_WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/username/
# DOCUMENT_STORAGE_WEBDAV_USERNAME=
# DOCUMENT_STORAGE_WEBDAV_PASSWORD=
# DOCUMENT_STORAGE_WEBDAV_PATH=aashiyana-documents
# DOCUMENT_STORAGE_WEBDAV_ALLOW_PRIVATE_NETWORK=false

# Recipe Provider Integrations
# RECIPE_PROVIDER_ALLOW_PRIVATE_NETWORK=false

# Waste Collection Sources
# WASTE_SOURCE_ALLOW_PRIVATE_NETWORK=false

# Document Management Systems
# DMS_ALLOW_PRIVATE_NETWORK=true

# Web Push Notifications
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Email / SMTP
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=starttls
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM_ADDRESS=aashiyana@example.com
# EMAIL_FROM_NAME=Aashiyana

# Public application URL
# BASE_URL=https://aashiyana.example.com

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=5

# API Documentation
# ENABLE_API_DOCS=true

# MCP
# MCP_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Reverse Proxy
# TRUST_PROXY=1
# TRUST_PROXY=loopback

# Optional Immich Photo Screensaver
# IMMICH_URL=
# IMMICH_API_KEY=
# IMMICH_SCREENSAVER_ALBUM_ID=
```
